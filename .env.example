# AWS S3 (media hosting)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=ade-semi-wedding

# Supabase (submissions DB + realtime)
# Project URL, e.g. https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose in the browser; paired with RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only). Used by /api/submissions POST to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
